@techHiveBackend_HostAddress = https://localhost:7289
@token = PEGA_AQUI_EL_ACCESS_TOKEN

POST {{techHiveBackend_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Ana",
  "lastName": "García",
  "email": "ana@example.com",
  "password": "Ejemplo-password-123"
}

### Iniciar sesión y copiar accessToken en la variable token
POST {{techHiveBackend_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "ana@example.com",
  "password": "Ejemplo-password-123"
}

###

GET {{techHiveBackend_HostAddress}}/api/users
Authorization: Bearer {{token}}
Accept: application/json

###
POST {{techHiveBackend_HostAddress}}/api/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "Ana",
  "lastName": "García",
  "email": "otro@example.com"
}

###
GET {{techHiveBackend_HostAddress}}/api/users/1
Authorization: Bearer {{token}}

###
PUT {{techHiveBackend_HostAddress}}/api/users/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "Ana María",
  "lastName": "García",
  "email": "ana@example.com"
}

###
DELETE {{techHiveBackend_HostAddress}}/api/users/1
Authorization: Bearer {{token}}
